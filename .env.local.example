# Upstash Redis connection details
# Both naming conventions are supported for backward compatibility

# Upstash Redis (https://upstash.com)
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token_here


KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here

# Alpha Vantage API key for market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here


# OpenAI API key for AI features
OPENAI_API_KEY="your_openai_api_key_here"

# News API keys (for /api/news endpoint)
FINNHUB_API_KEY="your_finnhub_api_key_here"
EODHD_API_KEY="your_eodhd_api_key_here"
POLYGON_API_KEY="your_polygon_api_key_here"
NEWSAPI_API_KEY="your_newsapi_api_key_here"
# Note: ALPHA_VANTAGE_API_KEY above is also used for news sentiment (NEWS_SENTIMENT function)

# Cache TTL for news in seconds (default: 900 = 15 minutes)
NEWS_CACHE_TTL=900

# Allowed origins for API access (comma-separated list, no spaces)
# Example: https://bloomberg-terminal-nine.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="https://your-domain.vercel.app,http://localhost:3000"
